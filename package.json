{
  "name": "unihub-workshop",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "dev:api": "npm run dev --workspace @unihub/api",
    "build:api": "npm run build:shared && npm run db:generate && npm run build:db && npm run build --workspace @unihub/api",
    "start:api": "npm run start --workspace @unihub/api",
    "lint:api": "npm run lint --workspace @unihub/api",
    "format:api": "npm run format --workspace @unihub/api",
    "dev:worker": "npm run dev --workspace @unihub/worker",
    "build:worker": "npm run build:shared && npm run build --workspace @unihub/worker",
    "lint:worker": "npm run lint --workspace @unihub/worker",
    "build:shared": "npm run build --workspace @unihub/shared",
    "build:db": "npm run build --workspace @unihub/db",
    "db:generate": "npm run generate --workspace @unihub/db",
    "db:seed": "npm run seed --workspace @unihub/db",
    "dev:web": "npm run dev --workspace @unihub/web",
    "build:web": "npm run build:shared && npm run build:db && npm run build --workspace @unihub/web",
    "start:web": "npm run start --workspace @unihub/web",
    "lint:web": "npm run lint --workspace @unihub/web",
    "format:web": "npm run format --workspace @unihub/web"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "apps/api/src/**/*.ts": [
      "npm run format:api --",
      "npm run lint:api --"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamTpG/unihub-workshop.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/IamTpG/unihub-workshop/issues"
  },
  "homepage": "https://github.com/IamTpG/unihub-workshop#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
