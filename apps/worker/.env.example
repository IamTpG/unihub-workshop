NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Email (Gmail SMTP)
SMTP_USER=your-email@gmail.com
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="UniHub Workshop <your-email@gmail.com>"

# Nightly student import (optional)
# Absolute or CWD-relative path to the CSV file the nightly job will process.
# The worker reads this file at 2:00 AM daily and DELETES it after processing.
# Replace with a new file each night, or leave unset to disable the nightly job.
NIGHTLY_CSV_PATH=./samples/students-sample.csv
